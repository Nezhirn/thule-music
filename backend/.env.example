THULE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
THULE_DB_SCHEMA=public
# Tests run against the same database in this schema (dropped & recreated per session)
THULE_TEST_SCHEMA=thule_test
# Required. Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
THULE_SECRET_KEY=change-me-to-a-long-random-string
THULE_LIBRARY_PATH=./library
THULE_DATA_PATH=./data
THULE_LRCLIB_ENABLED=true
