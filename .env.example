# Thule Music in Docker: copy to .env next to docker-compose.yml and fill in.

# Signs sign-in tokens and stream links: long and random. Make one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
THULE_SECRET_KEY=

# The database. The bundled Postgres (docker compose --profile local-db up -d) is set up
# with this password on its first start:
POSTGRES_PASSWORD=
THULE_DATABASE_URL=postgresql+asyncpg://thule:${POSTGRES_PASSWORD}@postgres:5432/thule
# Or a Postgres of your own (13 or newer; the user may create the pg_trgm extension):
# THULE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Folders on this machine.
# Your music. Uploads go to its uploads/ folder.
MUSIC_LIBRARY=./library
# The server's own data: covers and transcodes.
SERVER_DATA=./data
# The bundled Postgres's database.
POSTGRES_DATA=./postgres

# The user the server runs as: who owns your music (`id -u` and `id -g`).
PUID=1000
PGID=1000

# The port on this machine for the app and the API. Behind a reverse proxy on this machine,
# open it to the proxy only: HTTP_PORT=127.0.0.1:8000
HTTP_PORT=8000

# Behind a reverse proxy in another container or on another machine: its address (or
# network), for the clients' addresses in the logs.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# Lyrics from lrclib.net for tracks without them.
THULE_LRCLIB_ENABLED=true
