# thule-music — environment variables for a Claude Code cloud environment.
# Paste into the environment's "Environment variables" field. Everyone using the
# environment can read these, so they are throwaway dev values for the VM-local database.
THULE_DATABASE_URL=postgresql+asyncpg://thule:thule@localhost:5432/thule
THULE_SECRET_KEY=cloud-dev-only-not-secret-5f1c0a7e9b3d4c2a8e6f
# lrclib.net is not on the default "Trusted" allowlist; tests mock it anyway.
THULE_LRCLIB_ENABLED=false
